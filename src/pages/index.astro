---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "../layouts/Layout.astro";

const homepageEntries = await getCollection("homepage");
const projects = await getCollection("projects");
const projectMap = new Map(projects.map((p) => [p.id, p]));

interface ShowcaseItem {
  title: string;
  subtitle?: string;
  image: ImageMetadata;
  href?: string;
}

const items: ShowcaseItem[] = [];

for (const entry of homepageEntries) {
  if (entry.data.type === "project") {
    const project = projectMap.get(entry.data.project);
    if (!project || project.data.ndaLocked) continue;
    items.push({
      title: project.data.title,
      subtitle: project.data.client,
      image: entry.data.overrideImage ?? project.data.heroImage,
      href: `/projects/${project.id}`,
    });
  } else {
    items.push({
      title: entry.data.title,
      subtitle: entry.data.caption,
      image: entry.data.image,
      href: entry.data.link,
    });
  }
}

const hasItems = items.length > 0;
---

<Layout title="Brandon's Portfolio">
  {
    hasItems && (
      <>
        <section
          id="showcase-carousel"
          class="relative w-full overflow-hidden"
          style="min-height: calc(100dvh - 64px);"
        >
          <div class="showcase-entrance relative w-full h-full">
            <div id="carousel-track" class="flex transition-transform duration-500 ease-out h-full">
              {
                items.map((item, i) => (
                  <div
                    class="carousel-slide shrink-0 w-full h-full relative"
                    style="min-height: calc(100dvh - 64px);"
                    data-index={i}
                  >
                    <Image
                      src={item.image}
                      alt={item.title}
                      widths={[800, 1200, 1600, 2000]}
                      sizes="100vw"
                      fetchpriority={i === 0 ? "high" : "auto"}
                      loading={i === 0 ? "eager" : "lazy"}
                      class="absolute inset-0 w-full h-full object-cover"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent" />
                    <div class="absolute bottom-0 left-0 right-0 p-8 sm:p-12 lg:p-16">
                      <h2 class="text-white text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight">
                        {item.title}
                      </h2>
                      {
                        item.subtitle && (
                          <p class="mt-2 text-white/80 text-lg sm:text-xl">{item.subtitle}</p>
                        )
                      }
                      {
                        item.href && (
                          <a
                            href={item.href}
                            class="inline-block mt-4 px-6 py-2 rounded-full bg-white/90 text-gray-900 text-sm font-medium hover:bg-white transition-colors"
                          >
                            View Project
                          </a>
                        )
                      }
                    </div>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex gap-2 z-10">
            {
              items.map((_, i) => (
                <button
                  class={`carousel-dot w-2.5 h-2.5 rounded-full transition-all duration-300 ${
                    i === 0 ? "bg-white scale-125" : "bg-white/50"
                  } focus-visible:outline-2 focus-visible:outline-white/80`}
                  data-index={i}
                  aria-label={`Go to slide ${i + 1}`}
                ></button>
              ))
            }
          </div>

          <button
            id="carousel-prev"
            class="absolute left-4 top-1/2 -translate-y-1/2 z-10 flex items-center justify-center w-12 h-12 rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors backdrop-blur-sm focus-visible:outline-2 focus-visible:outline-white/80"
            aria-label="Previous slide"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button
            id="carousel-next"
            class="absolute right-4 top-1/2 -translate-y-1/2 z-10 flex items-center justify-center w-12 h-12 rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors backdrop-blur-sm focus-visible:outline-2 focus-visible:outline-white/80"
            aria-label="Next slide"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </section>
      </>
    )
  }

  <section id="showcase-canvas" class="hidden min-h-dvh pt-24 pb-16">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl font-bold tracking-tight animate-fade-in-up">Brandon's Portfolio</h1>
      <p class="mt-4 text-lg text-gray-600 max-w-prose animate-fade-in-up" style="animation-delay: 0.1s;">
        Digital illustrator showcasing professional and personal work.
      </p>
    </div>
    {
      hasItems && (
        <div class="container mx-auto px-4 mt-12">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {
              items.map((item, i) => (
                <div
                  class:list={[
                    "group relative overflow-hidden rounded-lg animate-fade-in-up",
                    i % 3 === 1 ? "md:row-span-2" : "",
                  ]}
                  style={`animation-delay: ${i * 0.15}s;`}
                >
                  <div
                    class="relative w-full h-full"
                    style={i % 3 === 1 ? "aspect-ratio: 3/4;" : "aspect-ratio: 4/3;"}
                  >
                    <Image
                      src={item.image}
                      alt={item.title}
                      widths={[400, 800]}
                      sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                      fetchpriority={i === 0 ? "high" : "auto"}
                      loading={i === 0 ? "eager" : "lazy"}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
                    <div class="absolute bottom-0 left-0 right-0 p-4 translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
                      <h2 class="text-white font-semibold text-lg">{item.title}</h2>
                      {item.subtitle && <p class="text-white/70 text-sm">{item.subtitle}</p>}
                    </div>
                    {
                      item.href && (
                        <a href={item.href} class="absolute inset-0" aria-label={`View ${item.title}`}>
                          <span class="sr-only">View {item.title}</span>
                        </a>
                      )
                    }
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      )
    }
    {
      !hasItems && (
        <div class="container mx-auto px-4 mt-16 text-center text-gray-400">
          <p>No featured pieces yet.</p>
        </div>
      )
    }
  </section>

  <script>
    (function () {
      var params = new URLSearchParams(window.location.search);
      if (params.get("layout") === "canvas") {
        var carousel = document.getElementById("showcase-carousel");
        var canvas = document.getElementById("showcase-canvas");
        if (carousel) carousel.classList.add("hidden");
        if (canvas) canvas.classList.remove("hidden");
        return;
      }

      var track = document.getElementById("carousel-track");
      var dots = document.querySelectorAll(".carousel-dot");
      var prevBtn = document.getElementById("carousel-prev");
      var nextBtn = document.getElementById("carousel-next");

      if (!track) return;

      var slides = track.querySelectorAll(".carousel-slide");
      var totalSlides = slides.length;
      if (totalSlides === 0) return;

      var currentIndex = 0;
      var intervalId;
      var AUTO_DELAY = 5000;
      var isTransitioning = false;

      function goTo(index) {
        if (isTransitioning || index === currentIndex) return;
        if (index < 0) index = totalSlides - 1;
        if (index >= totalSlides) index = 0;
        isTransitioning = true;

        currentIndex = index;
        track.style.transform = "translateX(-" + (currentIndex * 100) + "%)";

        dots.forEach(function (dot, i) {
          if (i === currentIndex) {
            dot.classList.add("bg-white", "scale-125");
            dot.classList.remove("bg-white/50");
          } else {
            dot.classList.remove("bg-white", "scale-125");
            dot.classList.add("bg-white/50");
          }
        });

        setTimeout(function () {
          isTransitioning = false;
        }, 500);
      }

      function startAuto() {
        stopAuto();
        intervalId = setInterval(function () {
          goTo(currentIndex + 1);
        }, AUTO_DELAY);
      }

      function stopAuto() {
        if (intervalId) clearInterval(intervalId);
      }

      dots.forEach(function (dot) {
        dot.addEventListener("click", function () {
          var idx = parseInt(this.getAttribute("data-index"));
          goTo(idx);
          stopAuto();
          startAuto();
        });
      });

      if (prevBtn) {
        prevBtn.addEventListener("click", function () {
          goTo(currentIndex - 1);
          stopAuto();
          startAuto();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener("click", function () {
          goTo(currentIndex + 1);
          stopAuto();
          startAuto();
        });
      }

      var carousel = document.getElementById("showcase-carousel");
      if (carousel) {
        carousel.addEventListener("mouseenter", stopAuto);
        carousel.addEventListener("mouseleave", startAuto);
      }

      document.addEventListener("keydown", function (e) {
        if (carousel && carousel.classList.contains("hidden")) return;
        if (e.key === "ArrowLeft") {
          goTo(currentIndex - 1);
          stopAuto();
          startAuto();
        } else if (e.key === "ArrowRight") {
          goTo(currentIndex + 1);
          stopAuto();
          startAuto();
        }
      });

      if (totalSlides > 1) {
        startAuto();
      }
    })();
  </script>
</Layout>

<style>
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease forwards;
    opacity: 0;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .carousel-slide {
    animation: fadeInSlide 0.6s ease;
  }

  @keyframes fadeInSlide {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .showcase-entrance {
    animation: showcaseReveal 1s ease;
  }

  @keyframes showcaseReveal {
    from {
      opacity: 0;
      transform: scale(1.02);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>

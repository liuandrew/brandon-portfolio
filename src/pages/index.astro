---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import bgPaint1 from "../assets/general/BG+Paint+1.webp";
import bgPaint3 from "../assets/general/BG+Paint+3.webp";
import bgPaint4 from "../assets/general/BG+Paint+4.webp";
import bgPaint9 from "../assets/general/BG+paint+9.webp";

const slides = [bgPaint1, bgPaint3, bgPaint4, bgPaint9];
---

<Layout title="Brandon's Portfolio">
  <section
    id="showcase-carousel"
    class="relative w-full overflow-hidden rounded-b-xl"
    style="height: calc(100dvh - 66px);"
  >
    <div class="showcase-entrance relative w-full h-full">
      <div id="carousel-track" class="relative w-full h-full">
        {
          slides.map((image, i) => (
            <div
              class:list={[
                "carousel-slide absolute inset-0",
                i === 0 ? "opacity-100" : "opacity-0",
              ]}
              data-index={i}
            >
              <Image
                src={image}
                alt=""
                widths={[800, 1200, 1600, 2000]}
                sizes="100vw"
                fetchpriority={i === 0 ? "high" : "auto"}
                loading={i === 0 ? "eager" : "lazy"}
                class="absolute inset-0 w-full h-full object-cover"
              />
            </div>
          ))
        }
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex gap-2 z-10">
      {
        slides.map((_, i) => (
          <button
            class={`carousel-dot w-2.5 h-2.5 rounded-full transition-all duration-300 ${
              i === 0 ? "bg-white scale-125" : "bg-white/50"
            } focus-visible:outline-2 focus-visible:outline-white/80`}
            data-index={i}
            aria-label={`Go to slide ${i + 1}`}
          ></button>
        ))
      }
    </div>

    <button
      id="carousel-prev"
      class="absolute left-4 top-1/2 -translate-y-1/2 z-10 flex items-center justify-center w-12 h-12 rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors backdrop-blur-sm focus-visible:outline-2 focus-visible:outline-white/80"
      aria-label="Previous slide"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button
      id="carousel-next"
      class="absolute right-4 top-1/2 -translate-y-1/2 z-10 flex items-center justify-center w-12 h-12 rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors backdrop-blur-sm focus-visible:outline-2 focus-visible:outline-white/80"
      aria-label="Next slide"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </section>

  <section id="showcase-canvas" class="hidden min-h-dvh pt-24 pb-16">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl font-bold tracking-tight animate-fade-in-up">Brandon's Portfolio</h1>
      <p class="mt-4 text-lg text-gray-600 max-w-prose animate-fade-in-up" style="animation-delay: 0.1s;">
        Digital illustrator showcasing professional and personal work.
      </p>
    </div>
    <div class="container mx-auto px-4 mt-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          slides.map((image, i) => (
            <div
              class:list={[
                "group relative overflow-hidden rounded-lg animate-fade-in-up",
                i % 3 === 1 ? "md:row-span-2" : "",
              ]}
              style={`animation-delay: ${i * 0.15}s;`}
            >
              <div
                class="relative w-full h-full"
                style={i % 3 === 1 ? "aspect-ratio: 3/4;" : "aspect-ratio: 4/3;"}
              >
                <Image
                  src={image}
                  alt=""
                  widths={[400, 800]}
                  sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                  fetchpriority={i === 0 ? "high" : "auto"}
                  loading={i === 0 ? "eager" : "lazy"}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    (function () {
      var params = new URLSearchParams(window.location.search);
      if (params.get("layout") === "canvas") {
        var carousel = document.getElementById("showcase-carousel");
        var canvas = document.getElementById("showcase-canvas");
        if (carousel) carousel.classList.add("hidden");
        if (canvas) canvas.classList.remove("hidden");
        return;
      }

      var track = document.getElementById("carousel-track");
      var dots = document.querySelectorAll(".carousel-dot");
      var prevBtn = document.getElementById("carousel-prev");
      var nextBtn = document.getElementById("carousel-next");

      if (!track) return;

      var slides = track.querySelectorAll(".carousel-slide");
      var totalSlides = slides.length;
      if (totalSlides === 0) return;

      var currentIndex = 0;
      var intervalId;
      var AUTO_DELAY = 3000;
      var isTransitioning = false;

      function goTo(index) {
        if (isTransitioning || index === currentIndex) return;
        if (index < 0) index = totalSlides - 1;
        if (index >= totalSlides) index = 0;
        isTransitioning = true;

        slides[currentIndex].classList.remove("opacity-100");
        slides[currentIndex].classList.add("opacity-0");

        currentIndex = index;

        slides[currentIndex].classList.remove("opacity-0");
        slides[currentIndex].classList.add("opacity-100");

        dots.forEach(function (dot, i) {
          if (i === currentIndex) {
            dot.classList.add("bg-white", "scale-125");
            dot.classList.remove("bg-white/50");
          } else {
            dot.classList.remove("bg-white", "scale-125");
            dot.classList.add("bg-white/50");
          }
        });

        setTimeout(function () {
          isTransitioning = false;
        }, 300);
      }

      function startAuto() {
        stopAuto();
        intervalId = setInterval(function () {
          goTo(currentIndex + 1);
        }, AUTO_DELAY);
      }

      function stopAuto() {
        if (intervalId) clearInterval(intervalId);
      }

      dots.forEach(function (dot) {
        dot.addEventListener("click", function () {
          var idx = parseInt(this.getAttribute("data-index"));
          goTo(idx);
          stopAuto();
          setTimeout(() => {startAuto();}, 2000)
        });
      });

      if (prevBtn) {
        prevBtn.addEventListener("click", function () {
          goTo(currentIndex - 1);
          stopAuto();
          setTimeout(() => {startAuto();}, 2000)
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener("click", function () {
          goTo(currentIndex + 1);
          stopAuto();
          setTimeout(() => {startAuto();}, 2000)
        });
      }

      var carousel = document.getElementById("showcase-carousel");
      // if (carousel) {
        // carousel.addEventListener("mouseenter", stopAuto);
        // carousel.addEventListener("mouseleave", startAuto);
      // }

      document.addEventListener("keydown", function (e) {
        if (carousel && carousel.classList.contains("hidden")) return;
        if (e.key === "ArrowLeft") {
          goTo(currentIndex - 1);
          stopAuto();
          startAuto();
        } else if (e.key === "ArrowRight") {
          goTo(currentIndex + 1);
          stopAuto();
          startAuto();
        }
      });

      if (totalSlides > 1) {
        startAuto();
      }
    })();
  </script>
</Layout>

<style>
  .animate-fade-in-up {
    animation: fadeInUp 0.5s ease forwards;
    opacity: 0;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .carousel-slide {
    transition: opacity 0.3s ease-in-out;
  }

  .showcase-entrance {
    animation: showcaseReveal 0.5s ease;
  }

  @keyframes showcaseReveal {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

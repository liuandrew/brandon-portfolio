---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import sharp from "sharp";
import { dirname, resolve } from "path";
import { readFileSync } from "fs";

const pieces = await getCollection("personal");
pieces.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

async function makePlaceholder(filePath: string): Promise<string | null> {
  try {
    const buf = await sharp(filePath)
      .resize(20)
      .webp({ quality: 1 })
      .toBuffer();
    return `data:image/webp;base64,${buf.toString("base64")}`;
  } catch {
    return null;
  }
}

interface PersonalImage {
  img: typeof pieces[number]["data"]["images"][number];
  alt: string;
  placeholder: string | null;
}

const piecesWithPlaceholders: { piece: typeof pieces[number]; images: PersonalImage[] }[] =
  await Promise.all(
    pieces.map(async (piece) => {
      const mdAbsPath = resolve(piece.filePath!);
      const pieceDir = dirname(mdAbsPath);
      const rawFM = readFileSync(mdAbsPath, "utf-8");
      const fmBody = rawFM.match(/^---\n([\s\S]*?)\n---/)?.[1] ?? "";

      const rawPaths: string[] = [];
      const imagesSection = fmBody.match(/^images:\s*\n((?:\s*-\s*[^\n]+\n?)+)/m);
      if (imagesSection) {
        const matches = imagesSection[1].match(/"([^"]+)"/g);
        if (matches) {
          for (const m of matches) {
            rawPaths.push(m.replace(/"/g, ""));
          }
        }
      }

      const images: PersonalImage[] = await Promise.all(
        piece.data.images.map(async (img, idx) => {
          const raw = rawPaths[idx] ?? "";
          const placeholder = raw ? await makePlaceholder(resolve(pieceDir, raw)) : null;
          const title = piece.data.title ?? piece.id;
          return { img, alt: `${title} — ${idx + 1}`, placeholder };
        }),
      );

      return { piece, images };
    }),
  );
---

<Layout title="Personal — Brandon's Portfolio" description="A gallery of Brandon's personal illustrations.">
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold tracking-tight">Personal</h1>
    <!-- <p class="mt-2 text-lg text-gray-600 max-w-prose">
      A collection of personal illustrations, studies, and explorations.
    </p> -->

    {
      piecesWithPlaceholders.length === 0 ? (
        <p class="mt-12 text-gray-400">No pieces yet.</p>
      ) : (
        <div id="masonry" class="mt-10 columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6">
          {
            piecesWithPlaceholders.map(({ piece, images }) =>
              images.map(({ img, alt, placeholder }, idx) => (
                <div class="masonry-item break-inside-avoid overflow-hidden">
                  <button
                    class="blur-up lightbox-trigger relative overflow-hidden cursor-pointer border-0 p-0 bg-transparent text-left w-full"
                    data-lightbox-src={`/lightbox/personal/${piece.id}-${idx}.webp`}
                    data-alt={alt}
                    style="background: #ffffff;"
                  >
                    {placeholder && (
                      <img
                        src={placeholder}
                        alt=""
                        aria-hidden="true"
                        class="absolute inset-0 w-full h-full object-contain blur-up-placeholder"
                      />
                    )}
                    <Image
                      src={img}
                      alt={alt}
                      widths={[400, 800]}
                      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                      loading="lazy"
                      class="blur-up-full relative w-full h-auto pointer-events-none"
                    />
                  </button>
                </div>
              ))
            )
          }
        </div>
      )
    }
  </main>

  <div
    id="lightbox"
    class="lightbox-overlay fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-4 sm:p-8"
    role="dialog"
    aria-modal="true"
    aria-label="Image lightbox"
  >
    <button
      id="lightbox-close"
      class="absolute top-4 right-4 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors focus-visible:outline-2 focus-visible:outline-white/80"
      aria-label="Close lightbox"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-w-full max-h-full object-contain"
    />
  </div>
</Layout>

<script>
  function initLightbox() {
    var lightbox = document.getElementById("lightbox");
    var lightboxImg = document.getElementById("lightbox-img");
    var closeBtn = document.getElementById("lightbox-close");
    var triggers = document.querySelectorAll(".lightbox-trigger");
    var lastFocused = null;

    function openLightbox(src, alt) {
      lastFocused = document.activeElement;
      lightboxImg.src = src;
      lightboxImg.alt = alt;
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      document.documentElement.style.overflow = "clip";
      document.addEventListener("keydown", onKeyDown);
      setTimeout(function () { closeBtn.focus(); }, 50);
    }

    function closeLightbox() {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      document.documentElement.style.overflow = "";
      document.removeEventListener("keydown", onKeyDown);
      lightboxImg.src = "";
      if (lastFocused) lastFocused.focus();
    }

    function onKeyDown(e) {
      if (e.key === "Escape") {
        e.preventDefault();
        closeLightbox();
      }
    }

    triggers.forEach(function (btn) {
      btn.addEventListener("click", function () {
        var src = btn.dataset.lightboxSrc;
        var alt = btn.dataset.alt || "";
        if (src) openLightbox(src, alt);
      });
    });

    closeBtn.addEventListener("click", closeLightbox);
    lightbox.addEventListener("click", function (e) {
      if (e.target === lightbox) closeLightbox();
    });
  }

  initLightbox();
</script>

<style>
  .blur-up {
    position: relative;
  }
  .blur-up-placeholder {
    filter: blur(20px);
    transform: scale(1.1);
    transition: opacity 0.4s ease;
  }
  .blur-up-full {
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .blur-up-full.loaded {
    opacity: 1;
  }
  .blur-up-full.loaded + .blur-up-placeholder,
  .blur-up-placeholder:has(+ .blur-up-full.loaded) {
    opacity: 0;
  }
  .lightbox-overlay {
    will-change: opacity;
  }
  .lightbox-overlay.flex {
    animation: fadeIn 0.2s ease;
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>

<script>
  (function () {
    var masonry = document.getElementById("masonry");
    if (!masonry) return;

    var items = Array.from(masonry.querySelectorAll(".masonry-item"));
    if (items.length === 0) return;

    masonry.classList.remove("columns-1", "sm:columns-2", "lg:columns-3", "gap-6", "space-y-6");

    var colsWrap = document.createElement("div");
    colsWrap.className = "masonry-cols flex gap-6";
    masonry.appendChild(colsWrap);

    var currentCols = 0;
    var columnEls = [];
    var laidOut = false;

    function getColumnCount() {
      var w = window.innerWidth;
      if (w >= 1024) return 3;
      if (w >= 640) return 2;
      return 1;
    }

    function getItemHeight(el) {
      return el.getBoundingClientRect().height + 24;
    }

    function layout() {
      var count = getColumnCount();
      if (count === currentCols && laidOut) return;
      currentCols = count;

      columnEls.forEach(function (c) { c.el.remove(); });
      columnEls = [];
      colsWrap.innerHTML = "";

      for (var i = 0; i < count; i++) {
        var col = document.createElement("div");
        col.className = "masonry-col";
        col.style.flex = "1";
        col.style.minWidth = "0";
        col.style.display = "flex";
        col.style.flexDirection = "column";
        col.style.gap = "1.5rem";
        colsWrap.appendChild(col);
        columnEls.push({ el: col, h: 0 });
      }

      items.forEach(function (item) {
        var shortest = columnEls[0];
        for (var j = 1; j < columnEls.length; j++) {
          if (columnEls[j].h < shortest.h) shortest = columnEls[j];
        }
        shortest.el.appendChild(item);
        shortest.h += getItemHeight(item);
      });

      laidOut = true;
    }

    function attemptLayout() {
      var allMeasurable = items.every(function (item) {
        return item.getBoundingClientRect().height > 10;
      });
      if (allMeasurable) {
        layout();
        return true;
      }
      return false;
    }

    if (!attemptLayout()) {
      var attempts = 0;
      var checkTimer = setInterval(function () {
        attempts++;
        if (attemptLayout() || attempts > 40) {
          clearInterval(checkTimer);
        }
      }, 100);
    }

    var resizeTimer;
    window.addEventListener("resize", function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        items.forEach(function (item) {
          masonry.insertBefore(item, colsWrap);
        });
        laidOut = false;
        currentCols = 0;
        attemptLayout();
      }, 300);
    });
  })();
</script>

<script>
  document.querySelectorAll(".blur-up-full").forEach((img) => {
    const full = img;
    if (full.complete) {
      full.classList.add("loaded");
    } else {
      full.addEventListener("load", () => full.classList.add("loaded"));
    }
  });
</script>

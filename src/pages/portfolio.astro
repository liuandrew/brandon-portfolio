---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { readFileSync } from "fs";
import { dirname, resolve } from "path";
import sharp from "sharp";

const [portfolioEntry] = await getCollection("portfolio");
const projects = await getCollection("projects");
const projectMap = new Map(projects.map((p) => [p.id, p]));

function parseFmImages(filePath: string): { path: string; description: string | null }[] {
  const raw = readFileSync(filePath, "utf-8").replace(/\r\n/g, "\n");
  const fm = raw.match(/^---\n([\s\S]*?)\n---/)?.[1] ?? "";
  const imgKeyRe = /^images:\s*$/m;
  const imgStart = fm.search(imgKeyRe);
  if (imgStart === -1) return [];
  const afterKey = fm.slice(imgStart);
  const lines = afterKey.split("\n");
  let endLine = lines.length;
  for (let j = 1; j < lines.length; j++) {
    if (/^[A-Za-z]\w*:/.test(lines[j])) {
      endLine = j;
      break;
    }
  }
  const section = lines.slice(0, endLine).join("\n");
  const entries: { path: string; description: string | null }[] = [];
  const sectionLines = section.split("\n").filter((l) => l.trim());
  for (let i = 0; i < sectionLines.length; i++) {
    const srcMatch = sectionLines[i].match(/^\s*-\s+src:\s*"([^"]+)"/);
    if (srcMatch) {
      let description: string | null = null;
      const nextLine = sectionLines[i + 1];
      if (nextLine) {
        const descMatch = nextLine.match(/^\s+description:\s*"([^"]*)"/);
        if (descMatch) {
          description = descMatch[1];
          i++;
        }
      }
      entries.push({ path: srcMatch[1], description });
      continue;
    }
    const stringMatch = sectionLines[i].match(/^\s*-\s+"([^"]+)"/);
    if (stringMatch) {
      entries.push({ path: stringMatch[1], description: null });
    }
  }
  return entries;
}

function parseFmHero(filePath: string): string | null {
  const raw = readFileSync(filePath, "utf-8").replace(/\r\n/g, "\n");
  const fm = raw.match(/^---\n([\s\S]*?)\n---/)?.[1] ?? "";
  return fm.match(/^heroImage:\s*"([^"]+)"/m)?.[1] ?? null;
}

async function makePlaceholder(filePath: string): Promise<string | null> {
  try {
    const buf = await sharp(filePath)
      .resize(20)
      .webp({ quality: 1 })
      .toBuffer();
    return `data:image/webp;base64,${buf.toString("base64")}`;
  } catch {
    return null;
  }
}

type PortfolioEntry = string | { slug: string; images?: string[] };

function resolveImg(entry: any): any {
  return entry && typeof entry === "object" && "src" in entry ? entry.src : entry;
}

const projectDisplays = await Promise.all((portfolioEntry?.data.projects ?? []).map(async (entry: PortfolioEntry) => {
  const slug = typeof entry === "string" ? entry : entry.slug;
  const overrides = typeof entry === "object" ? entry.images : undefined;
  const project = projectMap.get(slug);
  if (!project || !project.filePath) return null;

  const mdDir = dirname(project.filePath);
  const heroRawPath = parseFmHero(project.filePath);
  const galleryRawEntries = parseFmImages(project.filePath);
  const displayTitle = project.data.portfolioTitle ?? project.data.title;

  const imagePaths = overrides && overrides.length > 0
    ? overrides
    : galleryRawEntries.slice(0, 4).map((e) => e.path);

  const displayImages = await Promise.all(imagePaths.map(async (overridePath, i) => {
    const absOverride = resolve(mdDir, overridePath);

    let lightboxSrc: string;
    let galleryIdx = -1;
    let isHero = false;
    if (heroRawPath && resolve(mdDir, heroRawPath) === absOverride) {
      lightboxSrc = "hero.webp";
      isHero = true;
    } else {
      galleryIdx = galleryRawEntries.findIndex((e) => resolve(mdDir, e.path) === absOverride);
      if (galleryIdx !== -1) {
        lightboxSrc = galleryRawEntries[galleryIdx].path.split("/").pop()!.replace(/\.[^.]+$/, ".webp");
      } else {
        lightboxSrc = overridePath.split("/").pop()!.replace(/\.[^.]+$/, ".webp");
      }
    }

    const description = galleryIdx !== -1 ? galleryRawEntries[galleryIdx]?.description ?? null : null;

    const img = isHero
      ? project.data.heroImage
      : galleryIdx !== -1
        ? resolveImg(project.data.images[galleryIdx])
        : resolveImg(project.data.images[0]);

    const placeholder = await makePlaceholder(absOverride);

    return { img, lightboxSrc, alt: `${displayTitle} asset ${i + 1}`, placeholder, description };
  }));

  const heroPlaceholder = heroRawPath ? await makePlaceholder(resolve(mdDir, heroRawPath)) : null;

  return { project, displayTitle, heroImage: project.data.heroImage, displayImages, heroPlaceholder };
})).then((items) => items.filter(Boolean));
---

<Layout title="Portfolio — Brandon's Portfolio">
  <main class="mx-auto max-w-[1400px] px-4 py-6">
    <h1 class="text-4xl font-bold tracking-tight">Portfolio</h1>

    {
      projectDisplays.length === 0 ? (
        <p class="mt-8 text-gray-500">No projects to show yet.</p>
      ) : (
        <div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-3">
          {projectDisplays.map(({ project, displayTitle, heroImage, displayImages, heroPlaceholder }) => {
            return (
              <div class="flex flex-col">
                {project.data.logo && (
                  <a
                    href={`/projects/${project.id}`}
                    class="mb-4 flex justify-center"
                  >
                    <Image
                      src={project.data.logo}
                      alt={`${displayTitle} logo`}
                      widths={[200, 400]}
                      sizes="400px"
                      loading="lazy"
                      class="h-28 w-auto object-contain"
                    />
                  </a>
                )}

                <div class="relative">
                  {project.data.portfolioLocked && (
                    <a
                      href="/login?redirect=/portfolio"
                      class="locked-overlay absolute inset-0 z-10 flex cursor-pointer bg-gray-300"
                      aria-label={`${displayTitle} (locked)`}
                    >
                      <div class="m-auto flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-white/60">
                          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                        <span class="sr-only">Login to view</span>
                      </div>
                    </a>
                  )}
                  <button
                    class="blur-up lightbox-trigger relative overflow-hidden cursor-pointer border-0 p-0 bg-transparent text-left w-full"
                    style="aspect-ratio: 16/9; background: #ffffff;"
                    data-lightbox-src={`/lightbox/${project.id}/hero.webp`}
                    data-alt={displayTitle}
                    tabindex={project.data.portfolioLocked ? "-1" : undefined}
                  >
                    {heroPlaceholder && (
                      <img
                        src={heroPlaceholder}
                        alt=""
                        aria-hidden="true"
                        class="absolute inset-0 w-full h-full object-contain blur-up-placeholder"
                      />
                    )}
                    <Image
                      src={heroImage}
                      alt={displayTitle}
                      widths={[400, 800]}
                      sizes="(min-width: 768px) 33vw, 100vw"
                      fetchpriority="high"
                      loading="eager"
                      class="blur-up-full h-full w-full object-cover hover:scale-102 transition-transform duration-300"
                    />
                  </button>
                </div>

                <div class={`mt-4 grid grid-cols-2 gap-2 ${project.data.portfolioLocked ? 'hidden locked-gallery' : ''}`}>
                  {displayImages.slice(0, 2).map(({ img, lightboxSrc, alt, placeholder, description }, i) => (
                    <button
                      class="blur-up lightbox-trigger relative overflow-hidden cursor-pointer border-0 p-0 bg-transparent text-left w-full"
                      style="aspect-ratio: 4/3; background: #ffffff;"
                      data-lightbox-src={`/lightbox/${project.id}/${lightboxSrc}`}
                      data-alt={alt}
                      data-description={description ?? ""}
                    >
                      {placeholder && (
                        <img
                          src={placeholder}
                          alt=""
                          aria-hidden="true"
                          class="absolute inset-0 w-full h-full object-contain blur-up-placeholder"
                        />
                      )}
                      <Image
                        src={img}
                        alt={alt}
                        widths={[300, 500]}
                        sizes="(min-width: 768px) 17vw, 50vw"
                        loading="lazy"
                        class="blur-up-full h-full w-full object-cover hover:scale-102 transition-transform duration-300"
                      />
                    </button>
                  ))}
                  {displayImages.slice(2, 4).map(({ img, lightboxSrc, alt, placeholder, description }) => (
                    <button
                      class="blur-up lightbox-trigger relative overflow-hidden cursor-pointer border-0 p-0 bg-transparent text-left w-full sm:block hidden"
                      style="aspect-ratio: 4/3; background: #ffffff;"
                      data-lightbox-src={`/lightbox/${project.id}/${lightboxSrc}`}
                      data-alt={alt}
                      data-description={description ?? ""}
                    >
                      {placeholder && (
                        <img
                          src={placeholder}
                          alt=""
                          aria-hidden="true"
                          class="absolute inset-0 w-full h-full object-contain blur-up-placeholder"
                        />
                      )}
                      <Image
                        src={img}
                        alt={alt}
                        widths={[300, 500]}
                        sizes="(min-width: 768px) 17vw, 0px"
                        loading="lazy"
                        class="blur-up-full h-full w-full object-cover hover:scale-105 transition-transform duration-500"
                      />
                    </button>
                  ))}
                </div>

                <div class="mt-3">
                  <a href={`/projects/${project.id}`} class="block hover:opacity-70 transition-opacity">
                    <h2 class="text-lg font-semibold text-gray-900">
                      {displayTitle}
                    </h2>
                    <p class="mt-0.5 text-sm text-gray-500">
                      {project.data.client}
                    </p>
                    See More &rsaquo;
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      )
    }
  </main>

  <div
    id="lightbox"
    class="lightbox-overlay fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-4 sm:p-8"
    role="dialog"
    aria-modal="true"
    aria-label="Image lightbox"
  >
    <button
      id="lightbox-close"
      class="absolute top-4 right-4 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors focus-visible:outline-2 focus-visible:outline-white/80"
      aria-label="Close lightbox"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="flex flex-col items-center max-h-full">
      <img
        id="lightbox-img"
        src=""
        alt=""
        class="max-w-full max-h-[85vh] object-contain rounded-lg"
      />
      <p
        id="lightbox-desc"
        class="hidden text-white text-sm mt-3 text-center max-w-2xl"
      ></p>
    </div>
  </div>
</Layout>

<script>
  function initLightbox() {
    const lightbox = document.getElementById("lightbox");
    const lightboxImg = document.getElementById("lightbox-img");
    const closeBtn = document.getElementById("lightbox-close");
    const triggers = document.querySelectorAll(".lightbox-trigger");
    let lastFocused: HTMLElement | null = null;

    function openLightbox(src: string, alt: string, description?: string) {
      lastFocused = document.activeElement as HTMLElement;
      lightboxImg.src = src;
      lightboxImg.alt = alt;
      const descEl = document.getElementById("lightbox-desc");
      if (descEl) {
        if (description) {
          descEl.textContent = description;
          descEl.classList.remove("hidden");
        } else {
          descEl.textContent = "";
          descEl.classList.add("hidden");
        }
      }
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      document.documentElement.style.overflow = "clip";
      document.addEventListener("keydown", onKeyDown);
      setTimeout(() => closeBtn.focus(), 50);
    }

    function closeLightbox() {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      document.documentElement.style.overflow = "";
      document.removeEventListener("keydown", onKeyDown);
      lightboxImg.src = "";
      const descEl = document.getElementById("lightbox-desc");
      if (descEl) {
        descEl.textContent = "";
        descEl.classList.add("hidden");
      }
      if (lastFocused) lastFocused.focus();
    }

    function onKeyDown(e: KeyboardEvent) {
      if (e.key === "Escape") {
        e.preventDefault();
        closeLightbox();
      }
    }

    triggers.forEach((btn) => {
      btn.addEventListener("click", () => {
        const src = (btn as HTMLElement).dataset.lightboxSrc;
        const alt = (btn as HTMLElement).dataset.alt;
        const description = (btn as HTMLElement).dataset.description;
        if (src) openLightbox(src, alt ?? "", description);
      });
    });

    closeBtn.addEventListener("click", closeLightbox);

    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) closeLightbox();
    });
  }

  initLightbox();
</script>

<style>
  .blur-up {
    position: relative;
  }
  .blur-up-placeholder {
    filter: blur(20px);
    transform: scale(1.1);
    transition: opacity 0.3s ease;
  }
  .blur-up-full {
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .blur-up-full.loaded {
    opacity: 1;
  }
  .blur-up-full.loaded + .blur-up-placeholder,
  .blur-up-placeholder:has(+ .blur-up-full.loaded) {
    opacity: 0;
  }
  .lightbox-overlay {
    will-change: opacity;
  }
  .lightbox-overlay.flex {
    animation: fadeIn 0.2s ease;
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>

<script>
  document.querySelectorAll(".blur-up-full").forEach((img) => {
    const full = img;
    if (full.complete) {
      full.classList.add("loaded");
    } else {
      full.addEventListener("load", () => full.classList.add("loaded"));
    }
  });
</script>

<script>
  (function () {
    function getCookie(name) {
      var match = document.cookie.match(new RegExp("(^| )" + name + "=([^;]+)"));
      return match ? match[2] : null;
    }

    if (getCookie("nda-auth") === "1") {
      document.querySelectorAll(".locked-overlay").forEach(function (el) {
        var container = el.parentElement;
        el.remove();
        var btn = container && container.querySelector("button");
        if (btn) btn.removeAttribute("tabindex");
      });
      document.querySelectorAll(".locked-gallery").forEach(function (el) {
        el.classList.remove("hidden");
      });
    }
  })();
</script>

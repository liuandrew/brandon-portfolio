---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";

const [portfolioEntry] = await getCollection("portfolio");
const projects = await getCollection("projects");
const projectMap = new Map(projects.map((p) => [p.id, p]));

const items = (portfolioEntry?.data.projects ?? [])
  .map((slug) => {
    const project = projectMap.get(slug);
    if (!project) return null;
    return project;
  })
  .filter(Boolean);
---

<Layout title="Portfolio — Brandon's Portfolio">
  <main class="mx-auto max-w-[1400px] px-4 py-6">
    <h1 class="text-4xl font-bold tracking-tight">Portfolio</h1>

    {
      items.length === 0 ? (
        <p class="mt-8 text-gray-500">No projects to show yet.</p>
      ) : (
        <div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-3">
          {items.map((project) => {
            const displayTitle = project.data.portfolioTitle ?? project.data.title;
            return (
              <div class="flex flex-col">
                {project.data.logo && (
                  <a
                    href={`/projects/${project.id}`}
                    class="mb-4 flex justify-center"
                  >
                    <Image
                      src={project.data.logo}
                      alt={`${displayTitle} logo`}
                      widths={[200, 400]}
                      sizes="400px"
                      loading="lazy"
                      class="h-28 w-auto object-contain"
                    />
                  </a>
                )}

                <button
                  class="lightbox-trigger relative overflow-hidden cursor-pointer border-0 p-0 bg-transparent text-left w-full"
                  style="aspect-ratio: 16/9; background: #1a1050;"
                  data-src={project.data.heroImage.src}
                  data-alt={displayTitle}
                >
                  <Image
                    src={project.data.heroImage}
                    alt={displayTitle}
                    widths={[400, 800]}
                    sizes="(min-width: 768px) 33vw, 100vw"
                    fetchpriority="high"
                    loading="eager"
                    class="h-full w-full object-cover hover:scale-105 transition-transform duration-500"
                  />
                </button>

                <div class="mt-4 grid grid-cols-2 gap-2">
                  {project.data.images.slice(0, 2).map((img, i) => (
                    <button
                      class="lightbox-trigger relative overflow-hidden cursor-pointer border-0 p-0 bg-transparent text-left w-full"
                      style="aspect-ratio: 4/3; background: #1a1050;"
                      data-src={img.src}
                      data-alt={`${displayTitle} asset ${i + 1}`}
                    >
                      <Image
                        src={img}
                        alt={`${displayTitle} asset ${i + 1}`}
                        widths={[300, 500]}
                        sizes="(min-width: 768px) 17vw, 50vw"
                        loading="lazy"
                        class="h-full w-full object-cover hover:scale-105 transition-transform duration-500"
                      />
                    </button>
                  ))}
                  {project.data.images.slice(2, 4).map((img, i) => (
                    <button
                      class="lightbox-trigger relative overflow-hidden cursor-pointer border-0 p-0 bg-transparent text-left w-full sm:block hidden"
                      style="aspect-ratio: 4/3; background: #1a1050;"
                      data-src={img.src}
                      data-alt={`${displayTitle} asset ${i + 3}`}
                    >
                      <Image
                        src={img}
                        alt={`${displayTitle} asset ${i + 3}`}
                        widths={[300, 500]}
                        sizes="(min-width: 768px) 17vw, 0px"
                        loading="lazy"
                        class="h-full w-full object-cover hover:scale-105 transition-transform duration-500"
                      />
                    </button>
                  ))}
                </div>

                <div class="mt-3">
                  <a href={`/projects/${project.id}`} class="block hover:opacity-70 transition-opacity">
                    <h2 class="text-lg font-semibold text-gray-900">
                      {displayTitle}
                    </h2>
                    <p class="mt-0.5 text-sm text-gray-500">
                      {project.data.client}
                    </p>
                    See More &rsaquo;
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      )
    }
  </main>

  <div
    id="lightbox"
    class="lightbox-overlay fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-4 sm:p-8"
    role="dialog"
    aria-modal="true"
    aria-label="Image lightbox"
  >
    <button
      id="lightbox-close"
      class="absolute top-4 right-4 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors focus-visible:outline-2 focus-visible:outline-white/80"
      aria-label="Close lightbox"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-w-full max-h-full object-contain rounded-lg"
    />
  </div>
</Layout>

<script>
  function initLightbox() {
    const lightbox = document.getElementById("lightbox");
    const lightboxImg = document.getElementById("lightbox-img");
    const closeBtn = document.getElementById("lightbox-close");
    const triggers = document.querySelectorAll(".lightbox-trigger");
    let lastFocused: HTMLElement | null = null;

    function openLightbox(src: string, alt: string) {
      lastFocused = document.activeElement as HTMLElement;
      lightboxImg.src = src;
      lightboxImg.alt = alt;
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      document.documentElement.style.overflow = "clip";
      document.addEventListener("keydown", onKeyDown);
      setTimeout(() => closeBtn.focus(), 50);
    }

    function closeLightbox() {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      document.documentElement.style.overflow = "";
      document.removeEventListener("keydown", onKeyDown);
      lightboxImg.src = "";
      if (lastFocused) lastFocused.focus();
    }

    function onKeyDown(e: KeyboardEvent) {
      if (e.key === "Escape") {
        e.preventDefault();
        closeLightbox();
      }
    }

    triggers.forEach((btn) => {
      btn.addEventListener("click", () => {
        const src = (btn as HTMLElement).dataset.src;
        const alt = (btn as HTMLElement).dataset.alt;
        if (src) openLightbox(src, alt ?? "");
      });
    });

    closeBtn.addEventListener("click", closeLightbox);

    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) closeLightbox();
    });
  }

  initLightbox();
</script>

<style>
  .lightbox-overlay {
    will-change: opacity;
  }
  .lightbox-overlay.flex {
    animation: fadeIn 0.2s ease;
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>

---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "../layouts/Layout.astro";

const portfolioEntries = await getCollection("portfolio");
const projects = await getCollection("projects");
const projectMap = new Map(projects.map((p) => [p.id, p]));

interface Card {
  title: string;
  subtitle?: string;
  image: ImageMetadata;
  href: string;
}

const cards: Card[] = [];

for (const entry of portfolioEntries) {
  if (entry.data.type === "project") {
    const project = projectMap.get(entry.data.project);
    if (!project || project.data.ndaLocked) continue;
    cards.push({
      title: project.data.title,
      subtitle: project.data.client,
      image: entry.data.overrideImage ?? project.data.heroImage,
      href: `/projects/${project.id}`,
    });
  } else {
    cards.push({
      title: entry.data.title,
      subtitle: entry.data.caption,
      image: entry.data.image,
      href: entry.data.link,
    });
  }
}
---

<Layout title="Portfolio — Brandon's Portfolio">
  <main class="container mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold tracking-tight">Portfolio</h1>

    {
      cards.length === 0 ? (
        <p class="mt-8 text-gray-500">No projects to show yet.</p>
      ) : (
        <div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {
            cards.map((card, i) => (
              <a
                href={card.href}
                class="group block rounded-lg overflow-hidden border border-gray-200 hover:border-gray-300 transition-colors"
              >
                <div
                  class="relative overflow-hidden"
                  style="aspect-ratio: 4/3; background: #1a1050;"
                >
                  <Image
                    src={card.image}
                    alt={card.title}
                    widths={[400, 800]}
                    sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                    fetchpriority={i === 0 ? "high" : "auto"}
                    loading={i === 0 ? "eager" : "lazy"}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
                <div class="p-4">
                  <h2 class="text-lg font-semibold text-gray-900 group-hover:text-gray-600 transition-colors">
                    {card.title}
                  </h2>
                  {
                    card.subtitle && (
                      <p class="mt-1 text-sm text-gray-500">{card.subtitle}</p>
                    )
                  }
                </div>
              </a>
            ))
          }
        </div>
      )
    }
  </main>
</Layout>

---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import PasswordGate from "../../components/PasswordGate.astro";
import sharp from "sharp";
import { dirname, resolve } from "path";
import { readFileSync } from "fs";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;

const mdAbsPath = resolve(project.filePath!);
const projectDir = dirname(mdAbsPath);
const rawFM = readFileSync(mdAbsPath, "utf-8").replace(/\r\n/g, "\n");
const fmBody = rawFM.match(/^---\n([\s\S]*?)\n---/)?.[1] ?? "";

function fmString(key: string): string | null {
  const re = new RegExp(`^${key}:\\s*"([^"]*)"`, "m");
  return fmBody.match(re)?.[1] ?? null;
}

function fmArray(key: string): string[] {
  const re = new RegExp(`^${key}:\\s*\\n((?:\\s*-\\s*[^\\n]+\\n?)+)`, "m");
  const section = fmBody.match(re)?.[1] ?? "";
  return [...section.matchAll(/"([^"]+)"/g)].map((m) => m[1]);
}

function resolveSourcePath(rel: string): string {
  return resolve(projectDir, rel);
}

async function makePlaceholder(filePath: string): Promise<string | null> {
  try {
    const buf = await sharp(filePath)
      .resize(20)
      .webp({ quality: 1 })
      .toBuffer();
    return `data:image/webp;base64,${buf.toString("base64")}`;
  } catch {
    return null;
  }
}

const heroRawPath = fmString("heroImage");
const heroPlaceholder =
  heroRawPath ? await makePlaceholder(resolveSourcePath(heroRawPath)) : null;

interface GalleryItem {
  img: typeof data.images[number];
  alt: string;
  placeholder: string | null;
  outName: string;
}

const galleryRawPaths = fmArray("images");

const galleryImages: GalleryItem[] = await Promise.all(
  data.images.map(async (img, i) => {
    const raw = galleryRawPaths[i] ?? "";
    const placeholder = raw ? await makePlaceholder(resolveSourcePath(raw)) : null;
    const outName = raw ? raw.split('/').pop()!.replace(/\.[^.]+$/, '.webp') : `gallery-${i}.webp`;
    return { img, alt: `${data.title} gallery image ${i + 1}`, placeholder, outName };
  }),
);

const hasAnyPlaceholder =
  heroPlaceholder !== null || galleryImages.some((g) => g.placeholder !== null);
---

<Layout
  title={`${data.title} — Brandon's Portfolio`}
  description={data.description}
>
  <PasswordGate active={data.ndaLocked}>
    <main class="container mx-auto px-4 py-4 md:py-4">
    <div class="mb-2 flex flex-col items-center gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div class="text-center lg:text-left">
        <h1 class="text-2xl sm:text-4xl font-bold tracking-tight">{data.title}</h1>
        <p class="mt-2 text-1xl sm:text-lg text-gray-500">{data.client}</p>
      </div>
      {data.logo && (
        <Image
          src={data.logo}
          alt={`${data.title} logo`}
          widths={[200, 400]}
          sizes="400px"
          loading="lazy"
          class="h-30 w-auto object-contain lg:h-30"
        />
      )}
    </div>

    <div
      class="blur-up mt-4 md:mt-4 relative overflow-hidden"
      style="aspect-ratio: 16/9; max-height: 40rem; background: #ffffff;"
    >
      {
        heroPlaceholder && (
          <img
            src={heroPlaceholder}
            alt=""
            aria-hidden="true"
class="absolute inset-0 w-full h-full object-contain blur-up-placeholder"
            />
          )
        }
        <Image
          src={data.heroImage}
          alt={data.title}
          widths={[400, 800, 1200, 1600]}
          sizes="100vw"
          fetchpriority="high"
          loading="eager"
          class="blur-up-full relative w-full h-full object-contain"
      />
    </div>

    <p class="mt-8 max-w-prose text-lg leading-relaxed text-gray-600">
      {data.description}
    </p>

    {
      data.images.length > 0 && (
        <section class="mt-14">
          {/* <h2 class="text-2xl font-bold">Gallery</h2> */}
          <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {galleryImages.map(({ img, alt, placeholder, outName }) => (
              <button
                class="blur-up gallery-trigger relative overflow-hidden cursor-pointer border-0 p-0 bg-transparent text-left"
                style="aspect-ratio: 4/3; background: #ffffff;"
                data-lightbox-src={`/lightbox/${project.id}/${outName}`}
                aria-label={`View ${alt}`}
              >
                {
                  placeholder && (
                    <img
                      src={placeholder}
                      alt=""
                      aria-hidden="true"
class="absolute inset-0 w-full h-full object-contain blur-up-placeholder"
                  />
                )
              }
              <Image
                src={img}
                alt={alt}
                widths={[400, 800, 1200]}
                sizes="(min-width: 640px) 50vw, 100vw"
                loading="lazy"
                class="blur-up-full relative w-full h-full object-contain"
                />
              </button>
            ))}
          </div>
        </section>
      )
    }
  </main>

  <div
    id="lightbox"
    class="lightbox-overlay fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-4 sm:p-8"
    role="dialog"
    aria-modal="true"
    aria-label="Image lightbox"
  >
    <button
      id="lightbox-close"
      class="absolute top-4 right-4 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors focus-visible:outline-2 focus-visible:outline-white/80"
      aria-label="Close lightbox"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-w-full max-h-full object-contain"
    />
  </div>
  </PasswordGate>
</Layout>

{
  hasAnyPlaceholder && (
    <script>
      document.querySelectorAll(".blur-up-full").forEach((img) => {
        const full = img;
        if (full.complete) {
          full.classList.add("loaded");
        } else {
          full.addEventListener("load", () => full.classList.add("loaded"));
        }
      });
    </script>
  )
}

<script>
  function initLightbox() {
    const lightbox = document.getElementById("lightbox");
    const lightboxImg = document.getElementById("lightbox-img");
    const closeBtn = document.getElementById("lightbox-close");
    const triggers = document.querySelectorAll(".gallery-trigger");
    let lastFocused;
    const focusableSelectors =
      'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';

    function getFocusableEls() {
      return lightbox.querySelectorAll(focusableSelectors);
    }

    function trapFocus(e) {
      if (e.key !== "Tab") return;
      const focusable = getFocusableEls();
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault();
          last.focus();
        }
      } else {
        if (document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }

    function openLightbox(imgSrc, imgAlt) {
      lastFocused = document.activeElement;
      lightboxImg.src = imgSrc;
      lightboxImg.alt = imgAlt;
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      document.body.style.overflow = "hidden";
      document.addEventListener("keydown", onKeyDown);
      lightbox.addEventListener("keydown", trapFocus);
      setTimeout(() => closeBtn.focus(), 50);
    }

    function closeLightbox() {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      document.body.style.overflow = "";
      document.removeEventListener("keydown", onKeyDown);
      lightbox.removeEventListener("keydown", trapFocus);
      lightboxImg.src = "";
      if (lastFocused) lastFocused.focus();
    }

    function onKeyDown(e) {
      if (e.key === "Escape") {
        e.preventDefault();
        closeLightbox();
      }
    }

    triggers.forEach((btn) => {
      btn.addEventListener("click", () => {
        const src = btn.dataset.lightboxSrc;
        const fullImg = btn.querySelector(".blur-up-full");
        const alt = (fullImg && fullImg.alt) || "";
        if (src) openLightbox(src, alt);
      });
    });

    closeBtn.addEventListener("click", closeLightbox);

    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) closeLightbox();
    });
  }

  initLightbox();
</script>

<style>
  .blur-up {
    position: relative;
  }
  .blur-up-placeholder {
    filter: blur(20px);
    transform: scale(1.1);
    transition: opacity 0.3s ease;
  }
  .blur-up-full {
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .blur-up-full.loaded {
    opacity: 1;
  }
  .blur-up-full.loaded + .blur-up-placeholder,
  .blur-up-placeholder:has(+ .blur-up-full.loaded) {
    opacity: 0;
  }
  .lightbox-overlay {
    will-change: opacity;
  }
  .lightbox-overlay.flex {
    animation: fadeIn 0.2s ease;
  }
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

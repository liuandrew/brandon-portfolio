---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Resume — Brandon's Portfolio"
  description="Brandon's professional resume. Downloadable PDF available."
>
  <main class="container mx-auto px-4 py-16 max-w-3xl">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-4xl font-bold tracking-tight">Resume</h1>
        <p class="mt-2 text-gray-600">Digital illustrator &amp; visual designer</p>
      </div>
      <a
        href="/Brandon-Resume.pdf"
        download
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-gray-900 text-white text-sm font-medium hover:bg-gray-800 transition-colors focus-visible:outline-2 focus-visible:outline-white/80"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        Download PDF
      </a>
    </div>

    <div class="mt-14 space-y-14">
      <!-- Experience -->
      <section>
        <h2 class="text-lg font-semibold text-gray-500 uppercase tracking-wider mb-6">
          Experience
        </h2>
        <div class="space-y-8">
          <div>
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
              <h3 class="text-xl font-bold text-gray-900">Senior Digital Illustrator</h3>
              <span class="text-sm text-gray-500 shrink-0">2020 &mdash; Present</span>
            </div>
            <p class="text-gray-600 mt-0.5">Studio Meridian &mdash; Seattle, WA</p>
            <p class="mt-2 text-gray-700">
              Lead illustrator for a boutique creative studio serving editorial,
              advertising, and brand identity clients. Directed visual style for
              30+ campaigns and mentored a team of three junior illustrators.
            </p>
          </div>

          <div>
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
              <h3 class="text-xl font-bold text-gray-900">Illustrator</h3>
              <span class="text-sm text-gray-500 shrink-0">2016 &mdash; 2020</span>
            </div>
            <p class="text-gray-600 mt-0.5">Brightline Creative &mdash; Portland, OR</p>
            <p class="mt-2 text-gray-700">
              Produced digital illustrations and brand assets for a diverse portfolio
              of clients in technology, publishing, and nonprofit sectors. Delivered
              200+ commissioned pieces with a 98% on-time rate.
            </p>
          </div>

          <div>
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
              <h3 class="text-xl font-bold text-gray-900">Junior Designer</h3>
              <span class="text-sm text-gray-500 shrink-0">2014 &mdash; 2016</span>
            </div>
            <p class="text-gray-600 mt-0.5">Canvas Co. &mdash; Portland, OR</p>
            <p class="mt-2 text-gray-700">
              Supported senior designers on branding and illustration projects.
              Built foundational skills in client communication, file management,
              and production workflows.
            </p>
          </div>
        </div>
      </section>

      <!-- Education -->
      <section>
        <h2 class="text-lg font-semibold text-gray-500 uppercase tracking-wider mb-6">
          Education
        </h2>
        <div>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
            <h3 class="text-xl font-bold text-gray-900">
              BFA in Illustration
            </h3>
            <span class="text-sm text-gray-500 shrink-0">2010 &mdash; 2014</span>
          </div>
          <p class="text-gray-600 mt-0.5">Pacific Northwest College of Art &mdash; Portland, OR</p>
          <p class="mt-2 text-gray-700">
            Graduated with honors. Concentration in digital media and visual
            storytelling. Senior thesis exhibited in the PNCA Annual Juried Show.
          </p>
        </div>
      </section>

      <!-- Selected Clients -->
      <section>
        <h2 class="text-lg font-semibold text-gray-500 uppercase tracking-wider mb-6">
          Selected Clients
        </h2>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 rounded-full bg-gray-100 text-gray-700 text-sm">
            Nike
          </span>
          <span class="px-3 py-1 rounded-full bg-gray-100 text-gray-700 text-sm">
            The New York Times
          </span>
          <span class="px-3 py-1 rounded-full bg-gray-100 text-gray-700 text-sm">
            WIRED
          </span>
          <span class="px-3 py-1 rounded-full bg-gray-100 text-gray-700 text-sm">
            Patagonia
          </span>
          <span class="px-3 py-1 rounded-full bg-gray-100 text-gray-700 text-sm">
            Sub Pop Records
          </span>
          <span class="px-3 py-1 rounded-full bg-gray-100 text-gray-700 text-sm">
            Airbnb
          </span>
          <span class="px-3 py-1 rounded-full bg-gray-100 text-gray-700 text-sm">
            REI
          </span>
          <span class="px-3 py-1 rounded-full bg-gray-100 text-gray-700 text-sm">
            Oregon Public Broadcasting
          </span>
        </div>
      </section>
    </div>
  </main>
</Layout>
